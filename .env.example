# ------------------------------------------------------------------
# SMART ATTENDANCE SYSTEM ENVIRONMENT VARIABLES
# ------------------------------------------------------------------

# Local SQLite (default for development):
DATABASE_URL=sqlite:///./attendance.db

# Production Supabase / PostgreSQL:
# Copy your database connection string from Supabase Project Settings -> Database -> Connection string (URI)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret Key (replace with secure random string in production)
JWT_SECRET=smart_attendance_jwt_secret_dev_key_2026

# Face Recognition Cosine Similarity Thresholds (0.0 to 1.0)
FACE_MATCH_THRESHOLD=0.48
FLAGGED_REVIEW_THRESHOLD=0.60

# Institutional Policy: Minimum Presence Score % required for 'Present'
DEFAULT_PRESENCE_THRESHOLD=75.0
